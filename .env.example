# ─────────────────────────────────────────────────────────────────────────────
# Jolly Roger — Review Monitor & Reply Assistant
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# --- Anthropic (reply drafting) -----------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Model used to draft replies. The project spec chose claude-sonnet-4-6.
DRAFT_MODEL=claude-sonnet-4-6

# --- Google Business Profile API ----------------------------------------------
# OAuth 2.0 client (Desktop app) downloaded from Google Cloud Console.
# Path to the client secret JSON, and where to cache the user token.
GOOGLE_CLIENT_SECRETS_FILE=client_secret.json
GOOGLE_TOKEN_FILE=token.json

# Filled in (or auto-discovered) after access is granted. See Phase 1 in README.
# Full resource names, e.g. accounts/123456789 and locations/987654321
GBP_ACCOUNT_NAME=
GBP_LOCATION_NAME=

# --- Email digest -------------------------------------------------------------
# SMTP works fine for a single inbox. (Gmail: use an App Password.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
DIGEST_FROM=jolly-roger-bot@example.com
# Good reviews (with draft replies to approve) go here.
DIGEST_TO=owner@example.com
# Bad reviews are routed straight to the manager instead of auto-drafted.
MANAGER_TO=manager@example.com
# A review at or below this star rating is treated as "bad" → manager.
BAD_REVIEW_MAX_STARS=2
# How many past approved replies to feed Claude as style examples.
EXAMPLE_COUNT=5

# Base URL of the approval dashboard, used to build links in the digest email.
DASHBOARD_BASE_URL=http://localhost:5000

# --- Storage ------------------------------------------------------------------
DATABASE_PATH=jolly_roger.db
